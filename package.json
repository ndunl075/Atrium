{
  "name": "atrium",
  "version": "0.2.0",
  "description": "A shared workspace that multiple AI agents join in order to do one job together.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "atrium": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.24.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
