{
  "name": "@ndunl075/atrium",
  "version": "0.4.0",
  "description": "A shared workspace that multiple AI agents join in order to do one job together.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "agent-coordination",
    "blackboard",
    "event-sourcing"
  ],
  "homepage": "https://github.com/ndunl075/Atrium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndunl075/Atrium.git"
  },
  "bugs": {
    "url": "https://github.com/ndunl075/Atrium/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "atrium": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "demo": "npm run build && node examples/demo/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.24.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
